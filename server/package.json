{
  "name": "turfslot-server",
  "version": "1.0.0",
  "description": "Backend for TurfSlot management system",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node scripts/seed.js",
    "postinstall": "prisma generate",
    "test": "vitest run --fileParallelism=false",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^5.21.1",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "prisma": "^5.21.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.2",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "@prisma/engines@5.21.1": true,
    "@prisma/client@5.21.1": true,
    "prisma@5.21.1": true
  }
}
