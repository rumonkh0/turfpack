{
  "info": {
    "name": "TurfSlot — Complete API Collection",
    "description": "Full API test suite for TurfSlot backend.\n\n## Setup\n1. Set `base_url` variable (default: http://localhost:5000)\n2. Run \"Admin Login\" first — it auto-sets the `token` variable\n3. For partner tests, run \"Partner Login\" after creating a partner\n\n## Folder Order\nFolders are numbered for recommended test flow:\n01 Auth → 02 Users → 03 Turfs → 04 Bookings → 05 Payments → 06 Products → 07 Orders → 08 Tournaments → 09 Accounts → 10 Expenses → 11 Incomes → 12 Partners → 13 Ledger → 14 Reports → 15 Upload → 16 License",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:5000", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "partner_token", "value": "", "type": "string" },
    { "key": "turf_id", "value": "", "type": "string" },
    { "key": "booking_id", "value": "", "type": "string" },
    { "key": "product_id", "value": "", "type": "string" },
    { "key": "order_id", "value": "", "type": "string" },
    { "key": "tournament_id", "value": "", "type": "string" },
    { "key": "user_id", "value": "", "type": "string" },
    { "key": "partner_id", "value": "", "type": "string" },
    { "key": "partner2_id", "value": "", "type": "string" },
    { "key": "expense_id", "value": "", "type": "string" },
    { "key": "income_id", "value": "", "type": "string" },
    { "key": "account_id", "value": "", "type": "string" },
    { "key": "journal_entry_id", "value": "", "type": "string" },
    { "key": "payment_id", "value": "", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "01 — Auth",
      "description": "Authentication endpoints. Run Admin Login first to populate the token.",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Test User\",\n  \"email\": \"testuser@mail.com\",\n  \"password\": \"password123\",\n  \"role\": \"staff\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["const res = pm.response.json();", "if (res.token) pm.collectionVariables.set('token', res.token);"] }
          }]
        },
        {
          "name": "Admin Login",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@mail.com\",\n  \"password\": \"00000000\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "const res = pm.response.json();",
              "if (res.token) {",
              "  pm.collectionVariables.set('token', res.token);",
              "  pm.test('Login successful', () => pm.expect(res.success).to.be.true);",
              "}"
            ] }
          }]
        },
        {
          "name": "Partner Login",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"karim@partner.com\",\n  \"password\": \"partner123\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "const res = pm.response.json();",
              "if (res.token) pm.collectionVariables.set('partner_token', res.token);"
            ] }
          }]
        },
        {
          "name": "Desktop Auto Login",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/auth/desktop-auto-login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" }
          }
        },
        {
          "name": "Get Current User (Me)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/auth/me"
          }
        }
      ]
    },
    {
      "name": "02 — Users (Admin)",
      "description": "User management. All endpoints require admin role.",
      "item": [
        {
          "name": "List All Users",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/users?sort=-createdAt&limit=50", "host": ["{{base_url}}"], "path": ["api", "users"], "query": [{ "key": "sort", "value": "-createdAt" }, { "key": "limit", "value": "50" }] }
          }
        },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/users",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Staff Member\",\n  \"email\": \"staff@mail.com\",\n  \"password\": \"password123\",\n  \"role\": \"staff\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["const res = pm.response.json();", "if (res.data?._id) pm.collectionVariables.set('user_id', res.data._id);"] }
          }]
        },
        {
          "name": "Get User by ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/users/{{user_id}}"
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/api/users/{{user_id}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Updated Staff Name\",\n  \"status\": \"active\"\n}"
            }
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/users/{{user_id}}"
          }
        }
      ]
    },
